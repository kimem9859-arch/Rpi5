// ESP32 WiFi 자격증명 템플릿.
//
//   cp wifi_credentials.h.example wifi_credentials.h
//   그리고 wifi_credentials.h 에 실제 비밀번호를 넣는다.
//   (wifi_credentials.h 는 gitignore — 비번이 저장소에 올라가지 않는다)
//
// 배열 순서 = 연결 우선순위. 펌웨어는 주변 SSID를 스캔해 위에 있는 것부터 잡는다.
// 신호 세기 기준이 아니다 — 1순위가 보이면 약하더라도 그쪽에 붙는다.
//
// ⚠️ 라즈베리파이의 WiFi 우선순위도 같게 맞춰야 한다. 규칙이 다르면 둘이 서로 다른
//    네트워크에 붙어 TCP 직결이 불가능해진다:
//      sudo nmcli connection modify "<1순위 SSID>" connection.autoconnect-priority 10
//      sudo nmcli connection modify "<2순위 SSID>" connection.autoconnect-priority 5

#pragma once

struct WifiCred { const char* ssid; const char* pass; };

static const WifiCred WIFI_CREDS[] = {
  { "MySSID_1", "password1" },   // 1순위
  { "MySSID_2", "password2" },   // 2순위
};

static const int WIFI_CRED_COUNT = sizeof(WIFI_CREDS) / sizeof(WIFI_CREDS[0]);
